# Sothema HR Intelligence — Optional Groq assistant configuration
# Store real values only in a private local .env or server secret manager.
GROQ_API_KEY=gsk_your_groq_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# Optional providers used by other app features (not the Groq HR assistant)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
